      <JDBCDataSource guiclass="TestBeanGUI" testclass="JDBCDataSource" testname="JDBC - node3" enabled="true">
        <stringProp name="connectionAge">5000</stringProp>
        <stringProp name="connectionProperties"></stringProp>
        <stringProp name="dataSource">galera3</stringProp>
        <stringProp name="dbUrl">jdbc:mariadb://${__P(db.host,127.0.0.1)}:${__P(db.port3,3308)}/${__P(db.name,appdb)}</stringProp>
        <stringProp name="driver">org.mariadb.jdbc.Driver</stringProp>
        <stringProp name="initQuery"></stringProp>
        <boolProp name="keepAlive">true</boolProp>
        <stringProp name="password">${__P(db.password,app_password)}</stringProp>
        <stringProp name="poolMax">${__P(db.pool.max,40)}</stringProp>
        <stringProp name="timeout">10000</stringProp>
        <stringProp name="trimInterval">60000</stringProp>
        <stringProp name="username">${__P(db.user,appuser)}</stringProp>
        <stringProp name="transactionIsolation">DEFAULT</stringProp>
        <boolProp name="autocommit">true</boolProp>
        <stringProp name="connectionPool">pool</stringProp>
        <stringProp name="checkQuery"></stringProp>
      </JDBCDataSource>
      <hashTree/>
      <SetupThreadGroup guiclass="SetupThreadGroupGui" testclass="SetupThreadGroup" testname="setUp - schema" enabled="true">
        <stringProp name="ThreadGroup.on_sample_error">stoptest</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller" enabled="true">
          <boolProp name="LoopController.continue_forever">false</boolProp>
          <stringProp name="LoopController.loops">1</stringProp>
        </elementProp>
        <stringProp name="ThreadGroup.num_threads">1</stringProp>
        <stringProp name="ThreadGroup.ramp_time">1</stringProp>
        <boolProp name="ThreadGroup.scheduler">false</boolProp>
        <stringProp name="ThreadGroup.duration"></stringProp>
        <stringProp name="ThreadGroup.delay"></stringProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
      </SetupThreadGroup>
      <hashTree>
        <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="CREATE TABLE IF NOT EXISTS load_test" enabled="true">
          <stringProp name="dataSource">galera1</stringProp>
          <stringProp name="queryType">Update Statement</stringProp>
          <stringProp name="query">CREATE TABLE IF NOT EXISTS load_test (id BIGINT UNSIGNED NOT NULL AUTO_INCREMENT, thread_id INT NOT NULL, iter_id BIGINT NOT NULL, token CHAR(36) NOT NULL, full_name VARCHAR(64) NOT NULL, email VARCHAR(128) NOT NULL, amount DECIMAL(12,2) NOT NULL, payload VARCHAR(255) NOT NULL, created_at TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP, PRIMARY KEY (id), UNIQUE KEY uq_token (token), KEY idx_thread (thread_id), KEY idx_created (created_at)) ENGINE=InnoDB</stringProp>
          <stringProp name="queryArguments"></stringProp>
          <stringProp name="queryArgumentsTypes"></stringProp>
          <stringProp name="variableNames"></stringProp>
          <stringProp name="resultSetHandler">Store as String</stringProp>
          <stringProp name="resultVariable"></stringProp>
          <stringProp name="queryTimeout"></stringProp>
          <stringProp name="resultSetMaxRows"></stringProp>
        </JDBCSampler>
        <hashTree/>
        <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="TRUNCATE TABLE load_test" enabled="true">
          <stringProp name="dataSource">galera1</stringProp>
          <stringProp name="queryType">Update Statement</stringProp>
          <stringProp name="query">TRUNCATE TABLE load_test</stringProp>
          <stringProp name="queryArguments"></stringProp>
          <stringProp name="queryArgumentsTypes"></stringProp>
          <stringProp name="variableNames"></stringProp>
          <stringProp name="resultSetHandler">Store as String</stringProp>
          <stringProp name="resultVariable"></stringProp>
          <stringProp name="queryTimeout"></stringProp>
          <stringProp name="resultSetMaxRows"></stringProp>
        </JDBCSampler>
        <hashTree/>
      </hashTree>
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="INSERT node1" enabled="true">
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller" enabled="true">
          <boolProp name="LoopController.continue_forever">false</boolProp>
          <stringProp name="LoopController.loops">${__P(loops.node1,33333)}</stringProp>
        </elementProp>
        <stringProp name="ThreadGroup.num_threads">${__P(threads.per.node,10)}</stringProp>
        <stringProp name="ThreadGroup.ramp_time">${__P(rampup,10)}</stringProp>
        <boolProp name="ThreadGroup.scheduler">false</boolProp>
        <stringProp name="ThreadGroup.duration"></stringProp>
        <stringProp name="ThreadGroup.delay"></stringProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
      </ThreadGroup>
      <hashTree>
        <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="INSERT INTO load_test [node1]" enabled="true">
          <stringProp name="dataSource">galera1</stringProp>
          <stringProp name="queryType">Prepared Update Statement</stringProp>
          <stringProp name="query">INSERT INTO load_test (thread_id, iter_id, token, full_name, email, amount, payload) VALUES (?,?,?,?,?,?,?)</stringProp>
          <stringProp name="queryArguments">${lt_thread},${lt_iter},${lt_token},${lt_name},${lt_email},${lt_amount},${lt_payload}</stringProp>
          <stringProp name="queryArgumentsTypes">INTEGER,BIGINT,VARCHAR,VARCHAR,VARCHAR,DECIMAL,VARCHAR</stringProp>
          <stringProp name="variableNames"></stringProp>
          <stringProp name="resultSetHandler">Store as String</stringProp>
          <stringProp name="resultVariable"></stringProp>
          <stringProp name="queryTimeout"></stringProp>
          <stringProp name="resultSetMaxRows"></stringProp>
        </JDBCSampler>
        <hashTree/>
      </hashTree>
