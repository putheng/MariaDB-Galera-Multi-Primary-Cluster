<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="MariaDB Galera - 1M inserts to all nodes" enabled="true">
      <stringProp name="TestPlan.comments">Inserts across all 3 nodes concurrently (one JDBC pool per node). Default total = 10*(33333+33333+33334) = 1,000,000.</stringProp>
      <boolProp name="TestPlan.functional_mode">false</boolProp>
      <boolProp name="TestPlan.tearDown_on_shutdown">true</boolProp>
      <boolProp name="TestPlan.serialize_threadgroups">false</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="User Defined Variables" enabled="true">
        <collectionProp name="Arguments.arguments"/>
      </elementProp>
      <stringProp name="TestPlan.user_define_classpath"></stringProp>
    </TestPlan>
    <hashTree>
      <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Generate row values" enabled="true">
        <stringProp name="cacheKey">true</stringProp>
        <stringProp name="filename"></stringProp>
        <stringProp name="parameters"></stringProp>
        <stringProp name="scriptLanguage">groovy</stringProp>
        <stringProp name="script">import java.util.UUID
import java.util.concurrent.ThreadLocalRandom
import org.apache.commons.lang3.RandomStringUtils

vars.put('lt_thread', ctx.getThreadNum().toString())
vars.put('lt_iter', vars.getIteration().toString())
vars.put('lt_token', UUID.randomUUID().toString())
vars.put('lt_name', RandomStringUtils.randomAlphabetic(12))
vars.put('lt_email', 'u' + System.nanoTime() + ctx.getThreadNum() + '@load.test')
vars.put('lt_amount', String.format(Locale.US, '%.2f', ThreadLocalRandom.current().nextDouble(1.0d, 10000.0d)))
vars.put('lt_payload', RandomStringUtils.randomAlphanumeric(120))
</stringProp>
      </JSR223PreProcessor>
      <hashTree/>
      <JDBCDataSource guiclass="TestBeanGUI" testclass="JDBCDataSource" testname="JDBC - node1" enabled="true">
        <stringProp name="connectionAge">5000</stringProp>
        <stringProp name="connectionProperties"></stringProp>
        <stringProp name="dataSource">galera1</stringProp>
        <stringProp name="dbUrl">jdbc:mariadb://${__P(db.host,127.0.0.1)}:${__P(db.port1,3306)}/${__P(db.name,appdb)}</stringProp>
        <stringProp name="driver">org.mariadb.jdbc.Driver</stringProp>
        <stringProp name="initQuery"></stringProp>
        <boolProp name="keepAlive">true</boolProp>
        <stringProp name="password">${__P(db.password,app_password)}</stringProp>
        <stringProp name="poolMax">${__P(db.pool.max,40)}</stringProp>
        <stringProp name="timeout">10000</stringProp>
        <stringProp name="trimInterval">60000</stringProp>
        <stringProp name="username">${__P(db.user,appuser)}</stringProp>
        <stringProp name="transactionIsolation">DEFAULT</stringProp>
        <boolProp name="autocommit">true</boolProp>
        <stringProp name="connectionPool">pool</stringProp>
        <stringProp name="checkQuery"></stringProp>
      </JDBCDataSource>
      <hashTree/>
      <JDBCDataSource guiclass="TestBeanGUI" testclass="JDBCDataSource" testname="JDBC - node2" enabled="true">
        <stringProp name="connectionAge">5000</stringProp>
        <stringProp name="connectionProperties"></stringProp>
        <stringProp name="dataSource">galera2</stringProp>
        <stringProp name="dbUrl">jdbc:mariadb://${__P(db.host,127.0.0.1)}:${__P(db.port2,3307)}/${__P(db.name,appdb)}</stringProp>
        <stringProp name="driver">org.mariadb.jdbc.Driver</stringProp>
        <stringProp name="initQuery"></stringProp>
        <boolProp name="keepAlive">true</boolProp>
